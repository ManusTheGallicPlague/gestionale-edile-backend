# Copy to .env and replace every CHANGE_ME. Never commit .env.

# ---------- Database ----------
DB_PORT=5434
# Owner of the tables: migrations and seed only.
DB_OWNER_PASSWORD=CHANGE_ME_OWNER
DATABASE_URL_OWNER=postgres://gestionale_owner:CHANGE_ME_OWNER@127.0.0.1:5434/gestionale
# The API: subject to Row Level Security. Every company query goes through here.
DB_APP_PASSWORD=CHANGE_ME_APP
DATABASE_URL_APP=postgres://gestionale_app:CHANGE_ME_APP@127.0.0.1:5434/gestionale
# Sign-in and sessions only: it reaches the auth schema and nothing else.
DB_AUTH_PASSWORD=CHANGE_ME_AUTH
DATABASE_URL_AUTH=postgres://gestionale_auth:CHANGE_ME_AUTH@127.0.0.1:5434/gestionale

# ---------- API ----------
HOST=127.0.0.1
PORT=3100
# At least 32 random characters: openssl rand -base64 48
CSRF_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# true in production (https). false only for local http.
COOKIE_SECURE=false
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
